PORT=3000
NODE_ENV=production

# --- SECRETS : génère-les toi-même, ne réutilise JAMAIS ces exemples ---
# JWT_SECRET (>= 32 caractères aléatoires) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Mot de passe du compte bde_admin (>= 12 caractères). Vide = mot de passe aléatoire affiché une fois au 1er démarrage.
ADMIN_PASSWORD=
# Code secret de promotion admin (/auth/become-admin, >= 12 caractères). Vide = fonction désactivée.
ADMIN_SECRET_KEY=

DB_PATH=./server/database/marsabet.db

# Emails (Gmail : utiliser un "mot de passe d'application")
BDE_EMAIL=marsatek.bde@gmail.com
EMAIL_USER=marsatek.bde@gmail.com
EMAIL_PASS=

# Réseau
# Nombre de reverse-proxies de confiance devant l'app (0 = aucun). N'active X-Forwarded-For que si tu es derrière un proxy.
TRUST_PROXY=0
# Origines autorisées en plus de la même origine (séparées par des virgules), ex: https://marsabet.example.com
ALLOWED_ORIGINS=
